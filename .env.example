# Copy to .env and fill in real values. NEVER commit .env.
# Only the keys for providers you actually run in config.yaml are required.

# The ranker calls every model through OpenRouter (one key). See DECISIONS.md D-31.
OPENROUTER_API_KEY=

# Direct-provider keys — only needed if you bypass OpenRouter for a given model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
